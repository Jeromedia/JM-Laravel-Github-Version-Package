{
  "name": "jeromedia/laravel-github-service",
  "description": "A Laravel package that detects the deployed Git tag and compares it with the latest GitHub release.",
  "type": "library",
  "keywords": [
    "jeromedia",
    "laravel",
    "github",
    "version",
    "release"
  ],
  "homepage": "https://github.com/jeromedia/laravel-github-service",
  "license": "MIT",
  "authors": [
    {
      "name": "Jerome",
      "email": "info@jeromedia.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jeromedia\\LaravelGithubService\\": "src/"
    }
  },
  "require": {
    "php": "^8.0",
    "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Jeromedia\\LaravelGithubService\\GithubServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
